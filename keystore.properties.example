# Copy this file to keystore.properties (gitignored) and fill in your values,
# or set the equivalent CRUNCH_* environment variables instead.
#
#   CRUNCH_KEYSTORE_FILE      -> storeFile
#   CRUNCH_KEYSTORE_PASSWORD  -> storePassword
#   CRUNCH_KEY_ALIAS          -> keyAlias
#   CRUNCH_KEY_PASSWORD       -> keyPassword
#
# storeFile is resolved relative to the repository root.

storeFile=release.jks
storePassword=change-me
keyAlias=crunch
keyPassword=change-me
